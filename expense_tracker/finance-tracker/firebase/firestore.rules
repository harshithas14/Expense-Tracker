rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // User's transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth.uid == userId;
        
        // Validate transaction data
        allow create, update: if request.resource.data.type in ['income', 'expense'] &&
                               request.resource.data.category is string &&
                               request.resource.data.amount is number &&
                               request.resource.data.amount > 0 &&
                               request.resource.data.date is number &&
                               request.resource.data.createdAt is timestamp;
      }
      
      // User's budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if request.auth.uid == userId;
        
        // Validate budget data
        allow create, update: if request.resource.data.category is string &&
                               request.resource.data.limit is number &&
                               request.resource.data.limit > 0 &&
                               request.resource.data.createdAt is timestamp;
      }
    }
  }
}
